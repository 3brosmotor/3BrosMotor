rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Public read for vehicles so customers anywhere in the world can browse stock
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow write: if isValidId(vehicleId);
    }

    // Public read for dealership settings & director profile photo
    match /dealership_settings/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    // Expenses ledger
    match /expenses/{expenseId} {
      allow read: if true;
      allow write: if isValidId(expenseId);
    }

    // Sales ledger
    match /sales/{saleId} {
      allow read: if true;
      allow write: if isValidId(saleId);
    }

    // Calendar events, reminders, notes
    match /calendar_events/{eventId} {
      allow read: if true;
      allow write: if isValidId(eventId);
    }

    match /reminders/{reminderId} {
      allow read: if true;
      allow write: if isValidId(reminderId);
    }

    match /notes/{noteId} {
      allow read: if true;
      allow write: if isValidId(noteId);
    }

    // Vehicle import documents & customs records (internal dealership records)
    match /documents/{documentId} {
      allow read: if true;
      allow write: if isValidId(documentId);
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
